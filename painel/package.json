{
  "name": "mb2-painel",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json && vitest run",
    "voz:medir": "VOZ_MEDIR=1 vitest run src/dominio/voz.medir.test.ts --reporter=verbose",
    "pagina": "vite build && node scripts/pagina_unica.mjs",
    "iphone": "node scripts/apresentacao_iphone.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
