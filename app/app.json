{
  "expo": {
    "name": "MB2 Obras",
    "slug": "mb2-obras",
    "owner": "mb2inc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.mb2incorporacoes.obras",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.mb2incorporacoes.obras"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "mb2obras",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O MB2 Obras usa suas fotos para anexar ao diário da obra.",
          "cameraPermission": "O MB2 Obras usa a câmera para registrar fotos da obra no diário.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
